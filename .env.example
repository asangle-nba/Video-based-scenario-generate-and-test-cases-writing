# LLM Provider: "openai" or "gemini"
LLM_PROVIDER=openai

# OpenAI settings (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Google Gemini settings (required when LLM_PROVIDER=gemini)
GOOGLE_API_KEY=...
GEMINI_MODEL=gemini-1.5-pro

# Video processing settings
FRAMES_PER_SECOND=1        # How many frames to sample per second of video
MAX_FRAMES=50              # Maximum number of frames to send to the LLM
FRAME_WIDTH=1280           # Resize frames to this width (maintains aspect ratio)
